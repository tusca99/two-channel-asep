<mxfile host="app.diagrams.net">
  <diagram id="structure" name="Module Structure">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- asep package -->
        <mxCell id="asep" value="asep/ (package)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- model.py -->
        <mxCell id="model" value="model.py&#xa;TwoChannelASEP" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;startSize=28;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="40" width="280" height="300" as="geometry" />
