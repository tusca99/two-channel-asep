          <mxGeometry x="640" y="120" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="cuda_body" value="• thread = replica (1:1)&#xa;• RNG on-device, float32&#xa;• stats on-device&#xa;• run_ensemble_cuda / _continue&#xa;• 12GB RTX 4070 120-180 Mstep/s" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=6;fontSize=10;fontColor=#880e4f;" vertex="1" parent="1">
