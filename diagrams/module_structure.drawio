          <mxGeometry x="330" y="80" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="model_methods" value="run(n_steps, sample_every, warmup)&#xa;get_bulk_densities() → ρ1,ρ2&#xa;get_currents() → J1,J2&#xa;get_site_density_profiles()&#xa;get_joint_density_samples()&#xa;reset()" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="180" width="260" height="120" as="geometry" />
