        <mxCell id="obs_methods" value="classify_phase(J1,J2,ρ1,ρ2,α,β,L)&#xa;→ 'LD'|'MC'|'HD/LD'|'LD/LD'&#xa;classify_phase_simple(...)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1">
