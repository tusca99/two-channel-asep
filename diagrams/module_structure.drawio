        <mxCell id="par_body" value="• scan_points / scan_points_samples&#xa;  ProcessPool 30 workers (78GiB)&#xa;• scan_phase_diagram_gpu&#xa;• scan_beta_gpu / scan_grid_gpu&#xa;• make_tasks (31×31, 31×21)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=6;fontSize=10;fontColor=#1a237e;" vertex="1" parent="1">
