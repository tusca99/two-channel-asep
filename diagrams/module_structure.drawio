        <mxCell id="model_body" value="• L, α, β, seed&#xa;• lane1, lane2 : int8[L]&#xa;• run(n_steps, sample_every, warmup)&#xa;  → Fenwick BKL (O log L)&#xa;• get_currents() / get_bulk_densities()" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=6;fontSize=10;fontColor=#1b5e20;" vertex="1" parent="1">
