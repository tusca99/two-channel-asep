        <mxCell id="mc_methods" value="_collect_moves(...)&#xa;→ (move_types, move_sites, move_rates)&#xa;mc_step_numba(...) → dt, e1, e2&#xa;run_mc_batched(...) → time, n_exit1, n_exit2&#xa;make_uniforms(n_steps, rng)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1">
