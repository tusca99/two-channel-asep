          <mxGeometry x="340" y="120" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="bkl_body" value="• run_bkl (classic, O n)&#xa;• run_bkl_fenwick (Fenwick, O log L)&#xa;  ~4.8 Mstep/s/core&#xa;• run_bkl_fenwick_batch (prange)&#xa;• _run_chunked streaming 1M×3 uniforms" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=6;fontSize=10;fontColor=#e65100;" vertex="1" parent="1">
