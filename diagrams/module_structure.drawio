        <!-- mc.py -->
        <mxCell id="mc" value="mc.py (numba kernel)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;startSize=28;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="40" width="300" height="220" as="geometry" />
