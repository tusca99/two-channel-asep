        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeWidth=1.5;strokeColor=#6a1b9a;endArrow=classic;" edge="1" parent="1" source="sample" target="out">
          <mxGeometry relative="1" as="geometry" />
