        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeWidth=1.5;strokeColor=#ef6c00;endArrow=classic;" edge="1" parent="1" source="out" target="obs">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="655"/><mxPoint x="1120" y="655"/><mxPoint x="1120" y="580"/></Array></mxGeometry>
