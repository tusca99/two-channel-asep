        <mxCell id="e3b" value="GPU" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeWidth=1.5;strokeColor=#c2185b;endArrow=classic;dashed=1;" edge="1" parent="1" source="block" target="gpu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeWidth=1.5;strokeColor=#6a1b9a;endArrow=classic;" edge="1" parent="1" source="cpu" target="step">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="430"/><mxPoint x="700" y="430"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeWidth=1.5;strokeColor=#6a1b9a;endArrow=classic;" edge="1" parent="1" source="gpu" target="step">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="430"/><mxPoint x="700" y="430"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeWidth=1.5;strokeColor=#2e7d32;endArrow=classic;" edge="1" parent="1" source="step" target="sample">
          <mxGeometry relative="1" as="geometry" />
