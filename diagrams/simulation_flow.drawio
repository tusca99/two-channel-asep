        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeWidth=2;strokeColor=#2e7d32;endArrow=classic;" edge="1" parent="1" source="run" target="block">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3a" value="CPU" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeWidth=1.5;strokeColor=#1976d2;endArrow=classic;dashed=1;" edge="1" parent="1" source="block" target="cpu">
          <mxGeometry relative="1" as="geometry" />
