<mxfile host="app.diagrams.net">
  <diagram id="mc-moves" name="MC Moves">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= VERTICES ================= -->
        <mxCell id="title" value="Gillespie MC step — possible moves &amp; rates" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="500" height="40" as="geometry" />
        </mxCell>

        <mxCell id="state" value="Configuration&#xa;(lane1, lane2)&#xa;L sites each" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="300" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="hop1" value="hop1_right  (rate 1)&#xa;lane1[i]=1 → lane1[i+1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hop2" value="hop2_left   (rate 1)&#xa;lane2[i+1]=1 → lane2[i]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1020" y="90" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ent1" value="enter1  (rate α)&#xa;needs lane1[0]=0 AND lane2[0]=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ent2" value="enter2  (rate α)&#xa;needs lane2[L−1]=0 AND lane1[L−1]=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1020" y="300" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="exit1" value="exit1  (rate β)&#xa;lane1[L−1]=1 → 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="exit2" value="exit2  (rate β)&#xa;lane2[0]=1 → 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1020" y="500" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Selection: choose move j with probability ∝ rate_j&#xa;Time advance: dt = −log(u₁) / Σ rate_j" style="text;html=1;strokeColor=none;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="120" width="380" height="50" as="geometry" />
        </mxCell>

        <!-- ================= EDGES (after vertices) ================= -->
        <mxCell id="e_hop1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeWidth=2;endArrow=classic;startArrow=none;" edge="1" parent="1" source="hop1" target="state">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_hop2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeWidth=2;endArrow=classic;startArrow=none;" edge="1" parent="1" source="hop2" target="state">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ent1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeWidth=2;endArrow=classic;startArrow=none;" edge="1" parent="1" source="ent1" target="state">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ent2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeWidth=2;endArrow=classic;startArrow=none;" edge="1" parent="1" source="ent2" target="state">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_exit1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeWidth=2;endArrow=classic;startArrow=none;" edge="1" parent="1" source="exit1" target="state">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_exit2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeWidth=2;endArrow=classic;startArrow=none;" edge="1" parent="1" source="exit2" target="state">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
